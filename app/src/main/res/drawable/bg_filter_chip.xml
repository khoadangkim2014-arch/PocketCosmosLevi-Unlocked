    </item>
    <item android:state_selected="true" android:state_focused="true">
        <layer-list><item><shape android:shape="rectangle"><solid android:color="@color/primary" /><corners android:radius="20dp" /></shape></item><item><shape android:shape="rectangle"><solid android:color="@color/glass_primary_fill" /><stroke android:width="2dp" android:color="@color/on_primary" /><corners android:radius="20dp" /></shape></item></layer-list>
    </item>
    <item android:state_checked="true">
        <layer-list><item><shape android:shape="rectangle"><solid android:color="@color/primary" /><corners android:radius="20dp" /></shape></item><item><shape android:shape="rectangle"><solid android:color="@color/glass_primary_fill" /><stroke android:width="1.2dp" android:color="@color/glass_border" /><corners android:radius="20dp" /></shape></item></layer-list>
